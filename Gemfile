source "https://rubygems.org"

# Usa exatamente o mesmo conjunto de gems do GitHub Pages,
# para o site rodar igual local e publicado.
gem "github-pages", group: :jekyll_plugins

# Necessário em versões recentes de Ruby
gem "webrick", "~> 1.8"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
end
